// Cloudflare reads this when it builds the relay from GitHub.
// "name" must match your worker's name in Cloudflare.
{
  "name": "haltewekker-relay",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  // Keep variables set in the Cloudflare dashboard when deploying from GitHub.
  "keep_vars": true,
  // Friends (0.25): one Durable Object per account, with SQLite storage (works on the free plan, nothing to set up).
  // Shared ride logs (0.28.1): one more, "Logs", that keeps the uploads 60 days.
  "durable_objects": {
    "bindings": [
      { "name": "FRIENDS", "class_name": "Friends" },
      { "name": "LOGS", "class_name": "Logs" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Friends"] },
    { "tag": "v2", "new_sqlite_classes": ["Logs"] }
  ]
}
